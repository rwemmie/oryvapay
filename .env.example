# Copy to .env and fill in. Never commit .env.
# If PayPal or AI keys are missing, OryvaPay runs in DEMO_MODE (simulated PayPal, local heuristic AI).

PORT=3000

# PayPal REST app (developer.paypal.com > Apps and Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Any OpenAI compatible API. Default is xAI Grok.
AI_BASE_URL=https://api.x.ai/v1
AI_API_KEY=
AI_MODEL=grok-4
# AI_TIMEOUT_MS=45000
# Crynux example: AI_BASE_URL=https://api.crynux-as.xyz/api/<endpoint_token>/v1  AI_MODEL=Qwen/Qwen2.5-7B-Instruct
# AI_VRAM_LIMIT=24   (sent only when AI_BASE_URL is a Crynux endpoint)

# Force demo mode even when keys exist
# DEMO_MODE=true
